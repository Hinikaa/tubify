# signs what cpack produces, when -DSWIFTIFY_WINDOWS_SIGN=ON and a certificate
# is configured. run twice: before the package is made, for the executable it
# will carry, and after, for the installer itself.
#
# the certificate's password is taken from the environment
# (TUBIFY_SIGN_PASSWORD), never from the cache, which is a file others read.

set(_signtool "@SWIFTIFY_WINDOWS_SIGNTOOL@")
set(_certificate "@SWIFTIFY_WINDOWS_SIGN_CERTIFICATE@")
set(_timestamp "@SWIFTIFY_WINDOWS_SIGN_TIMESTAMP@")

if(NOT _signtool OR NOT EXISTS "${_signtool}")
    message(FATAL_ERROR "SWIFTIFY_WINDOWS_SIGN is on, but signtool was not found. Point "
        "-DSWIFTIFY_WINDOWS_SIGNTOOL at signtool.exe from a windows sdk.")
endif()

function(tubify_sign file)
    if(NOT EXISTS "${file}")
        message(FATAL_ERROR "tubify_sign: there is no ${file}")
    endif()
    set(arguments sign /fd SHA256 /td SHA256 /tr "${_timestamp}" /d "Tubify")
    if(_certificate)
        list(APPEND arguments /f "${_certificate}")
        if(DEFINED ENV{TUBIFY_SIGN_PASSWORD} AND NOT "$ENV{TUBIFY_SIGN_PASSWORD}" STREQUAL "")
            list(APPEND arguments /p "$ENV{TUBIFY_SIGN_PASSWORD}")
        endif()
    else()
        # a certificate already in the machine's store, chosen by signtool
        list(APPEND arguments /a)
    endif()
    message(STATUS "Signing ${file}")
    execute_process(COMMAND "${_signtool}" ${arguments} "${file}"
        RESULT_VARIABLE result
        OUTPUT_VARIABLE output
        ERROR_VARIABLE output)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "signtool failed on ${file} (${result}):\n${output}")
    endif()
endfunction()

if(DEFINED CPACK_PACKAGE_FILES AND CPACK_PACKAGE_FILES)
    # the installer, once it is built. a zip has nothing to sign
    foreach(file IN LISTS CPACK_PACKAGE_FILES)
        if(file MATCHES "\\.exe$")
            tubify_sign("${file}")
        endif()
    endforeach()
elseif(DEFINED CPACK_TEMPORARY_DIRECTORY AND CPACK_TEMPORARY_DIRECTORY)
    # the executable the package will carry, and only ours: the qt dlls beside
    # it are someone else's, and stay as they were signed
    file(GLOB_RECURSE staged "${CPACK_TEMPORARY_DIRECTORY}/*/swiftify.exe")
    foreach(file IN LISTS staged)
        tubify_sign("${file}")
    endforeach()
endif()
