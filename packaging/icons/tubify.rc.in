/* what windows reads out of the executable: its icon, and the version explorer
 * shows under the file's properties. the manifest is not here: it is compiled
 * into the executable by the linker, from the file the target carries (see
 * CMakeLists.txt), and a second copy of it in the resources would be refused.
 *
 * configured by cmake into the build folder, so the version here is the one
 * the build has. the numbers are written out rather than included from
 * windows.h, which keeps the file compiling with every resource compiler.
 */

IDI_ICON1 ICON "@SWIFTIFY_WINDOWS_ICON@"

1 VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS          0x40004L   /* VOS_NT_WINDOWS32 */
FILETYPE        0x1L       /* VFT_APP */
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"   /* united states english, unicode */
        BEGIN
            VALUE "CompanyName",      "Hinikaa"
            VALUE "FileDescription",  "Tubify, a YouTube Music player for desktop"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "Tubify"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Hinikaa. Free software under the GNU GPL v3 or later."
            VALUE "OriginalFilename", "swiftify.exe"
            VALUE "ProductName",      "Tubify"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
